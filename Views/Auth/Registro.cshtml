@model FulbitoBravo.Models.Auth.RegistroViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="fb-auth-wrapper">
    <div class="fb-auth-card fb-auth-wide">
        <div class="fb-auth-icon"><i class="bi bi-person-plus"></i></div>
        <h2 class="mb-1">Crear cuenta de cliente</h2>
        <p class="text-muted mb-4">Regístrate para reservar canchas en línea.</p>

        <form asp-action="Registro" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DNI" class="form-label"></label>
                    <input asp-for="DNI" class="form-control" maxlength="8" placeholder="70123456" />
                    <span asp-validation-for="DNI" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-3" />

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">
                <i class="bi bi-check-circle me-1"></i> Crear cuenta
            </button>
        </form>

        <hr class="my-4" />
        <p class="text-center text-muted mb-0">
            ¿Ya tienes cuenta?
            <a asp-action="Login">Inicia sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
