@model FulbitoBravo.Models.PagoViewModel

@{
    ViewData["Title"] = "Registrar Pago";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Pago</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Registrar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="IdReserva" class="form-label">ID de Reserva</label>
                    <select asp-for="IdReserva" class="form-control" asp-items="ViewBag.ListaReservas">
                        <option value="">-- Seleccione Reserva --</option>
                    </select>
                    <span asp-validation-for="IdReserva" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Monto" class="form-label"></label>
                    <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaPago" class="form-label"></label>
                    <input asp-for="FechaPago" class="form-control" type="datetime-local" />
                    <span asp-validation-for="FechaPago" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EstadoPago" class="form-label"></label>
                    <input asp-for="EstadoPago" class="form-control" value="Pagado" />
                    <span asp-validation-for="EstadoPago" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>