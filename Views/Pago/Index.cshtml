@model IEnumerable<FulbitoBravo.Models.PagoViewModel>

@{
    ViewData["Title"] = "Listado de Pagos";
}

<div class="page-card">
    <h2><i class="bi bi-credit-card me-2"></i>Listado de Pagos</h2>

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-success">Nuevo Pago</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id Pago</th>
                <th>Id Reserva</th>
                <th>Monto</th>
                <th>Fecha de Pago</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdPago</td>
                    <td>@item.IdReserva</td>
                    <td>S/ @item.Monto.ToString("N2")</td>
                    <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.EstadoPago</td>
                </tr>
            }
        </tbody>
    </table>
</div>