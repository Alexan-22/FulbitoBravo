@model IEnumerable<FulbitoBravo.Models.PagoViewModel>

@{
    ViewData["Title"] = "Listado de Pagos";
}

<div class="container mt-4">
    <h2>Listado de Pagos</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-success">Nuevo Pago</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id Pago</th>
                <th>Id Reserva</th>
                <th>Monto</th>
                <th>Fecha de Pago</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdPago</td>
                    <td>@item.IdReserva</td>
                    <td>S/ @item.Monto.ToString("N2")</td>
                    <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.EstadoPago</td>
                </tr>
            }
        </tbody>
    </table>
</div>