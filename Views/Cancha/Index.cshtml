@model IEnumerable<FulbitoBravo.Models.CanchaViewModel>

@{
    ViewData["Title"] = "Listado de Canchas";
}

<div class="page-card">
    <h2><i class="bi bi-geo-alt me-2"></i>Listado de Canchas</h2>

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-success">Nueva Cancha</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCancha</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@(item.Estado ? "Activo" : "Inactivo")</td>
                </tr>
            }
        </tbody>
    </table>
</div>