@model IEnumerable<FulbitoBravo.Models.CanchaViewModel>

@{
    ViewData["Title"] = "Listado de Canchas";
}

<div class="page-card">
    <h2><i class="bi bi-geo-alt me-2"></i>Listado de Canchas</h2>

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-success">Nueva Cancha</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th style="width: 180px;">Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCancha</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>
                        <form asp-action="CambiarEstado" method="post" class="d-flex gap-2 align-items-center"
                              onsubmit="return confirm('¿Está seguro de cambiar el estado de esta cancha?');">
                            <input type="hidden" name="id" value="@item.IdCancha" />
                            <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="true" selected="@(item.Estado ? "selected" : null)">Activo</option>
                                <option value="false" selected="@(!item.Estado ? "selected" : null)">Inactivo</option>
                            </select>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>