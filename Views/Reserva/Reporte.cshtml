@model IEnumerable<FulbitoBravo.Models.ReservaViewModel>

@{
    ViewData["Title"] = "Reporte de Reservas";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    string fechaInicio = ViewBag.FechaInicio ?? "";
    string fechaFin = ViewBag.FechaFin ?? "";
}

<div class="page-card">
    <h2><i class="bi bi-bar-chart me-2"></i>Reporte de Reservas</h2>
    <p class="text-muted">Filtra las reservas por un rango de fechas.</p>

    @* ====== FILTRO DE FECHAS ====== *@
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Reporte" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Fecha Inicio</label>
                    <input type="date" name="fechaInicio" class="form-control" value="@fechaInicio" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha Fin</label>
                    <input type="date" name="fechaFin" class="form-control" value="@fechaFin" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary me-2">
                        Filtrar
                    </button>
                    <a asp-action="Reporte" class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    @* ====== TABLA DE RESULTADOS ====== *@
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Cliente</th>
                    <th>Cancha</th>
                    <th>Fecha</th>
                    <th>Horario</th>
                    <th>Estado Reserva</th>
                    <th>Monto</th>
                    <th>Estado Pago</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdReserva</td>
                            <td>@item.NombreCliente</td>
                            <td>@item.NombreCancha</td>
                            <td>@item.FechaReserva.ToString("dd/MM/yyyy")</td>
                            <td>@item.HorarioTexto</td>
                            <td>
                                @if (item.EstadoReserva == "Confirmada")
                                {
                                    <span class="badge bg-success">@item.EstadoReserva</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.EstadoReserva</span>
                                }
                            </td>
                            <td>
                                @(item.Monto.HasValue ? $"S/ {item.Monto.Value:N2}" : "-")
                            </td>
                            <td>
                                @if (item.EstadoPago == "Pagado")
                                {
                                    <span class="badge bg-primary">@item.EstadoPago</span>
                                }
                                else if (item.EstadoPago == "Reembolsado")
                                {
                                    <span class="badge bg-warning text-dark">@item.EstadoPago</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@(item.EstadoPago ?? "-")</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            No se encontraron reservas con los filtros seleccionados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ====== PAGINACIÓN ====== *@
    @if (totalPaginas > 1)
    {
        <nav aria-label="Paginación del reporte">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Reporte"
                       asp-route-pagina="@(paginaActual - 1)"
                       asp-route-fechaInicio="@fechaInicio"
                       asp-route-fechaFin="@fechaFin">
                        Anterior
                    </a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link"
                           asp-action="Reporte"
                           asp-route-pagina="@i"
                           asp-route-fechaInicio="@fechaInicio"
                           asp-route-fechaFin="@fechaFin">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Reporte"
                       asp-route-pagina="@(paginaActual + 1)"
                       asp-route-fechaInicio="@fechaInicio"
                       asp-route-fechaFin="@fechaFin">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>

        <p class="text-center text-muted">
            Página @paginaActual de @totalPaginas
            (Total: @ViewBag.TotalRegistros registros)
        </p>
    }
    else if (Model != null && Model.Any())
    {
        <p class="text-center text-muted">
            Total: @ViewBag.TotalRegistros registros
        </p>
    }
</div>