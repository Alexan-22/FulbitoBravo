@model IEnumerable<FulbitoBravo.Models.ReservaViewModel>

@{
    ViewData["Title"] = "Mis Reservas";
}

<div class="page-card">
    <h2><i class="bi bi-calendar-check me-2"></i>Mis Reservas</h2>

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Nueva Reserva</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Cancha</th>
                    <th>Fecha</th>
                    <th>Horario</th>
                    <th>Estado</th>
                    <th>Monto</th>
                    <th>Estado Pago</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdReserva</td>
                            <td>@item.NombreCancha</td>
                            <td>@item.FechaReserva.ToString("dd/MM/yyyy")</td>
                            <td>@item.HorarioTexto</td>
                            <td>
                                @if (item.EstadoReserva == "Confirmada")
                                {
                                    <span class="badge bg-success">@item.EstadoReserva</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.EstadoReserva</span>
                                }
                            </td>
                            <td>@(item.Monto.HasValue ? $"S/ {item.Monto.Value:N2}" : "-")</td>
                            <td>
                                @if (item.EstadoPago == "Pagado")
                                {
                                    <span class="badge bg-primary">@item.EstadoPago</span>
                                }
                                else if (item.EstadoPago == "Reembolsado")
                                {
                                    <span class="badge bg-warning text-dark">@item.EstadoPago</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@(item.EstadoPago ?? "-")</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Aún no tienes reservas registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
