@model IEnumerable<FulbitoBravo.Models.ReservaViewModel>

@{
    ViewData["Title"] = "Listado de Reservas";
}

<div class="container mt-4">
    <h2>Listado de Reservas</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-success">Nueva Reserva</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Cliente</th>
                <th>Cancha</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdReserva</td>
                    <td>@item.NombreCliente</td>
                    <td>@item.NombreCancha</td>
                    <td>@item.FechaReserva.ToString("dd/MM/yyyy")</td>
                    <td>@item.HorarioTexto</td>
                    <td>@item.EstadoReserva</td>
                </tr>
            }
        </tbody>
    </table>
</div>