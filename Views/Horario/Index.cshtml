@model IEnumerable<FulbitoBravo.Models.HorarioViewModel>

@{
    ViewData["Title"] = "Listado de Horarios";
}

<div class="container mt-4">
    <h2>Listado de Horarios</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-success">Nuevo Horario</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdHorario</td>
                    <td>@item.HoraInicio.ToString(@"hh\:mm")</td>
                    <td>@item.HoraFin.ToString(@"hh\:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>